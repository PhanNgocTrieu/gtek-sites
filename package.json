{
  "name": "tmp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-experimental-webstorage' WATCHPACK_POLLING=true next dev",
    "dev:docker": "WATCHPACK_POLLING=true next dev --hostname 0.0.0.0 --port 3000",
    "build": "NODE_OPTIONS='--no-experimental-webstorage' next build",
    "build:docker": "next build",
    "start": "NODE_OPTIONS='--no-experimental-webstorage' next start",
    "start:docker": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "test:resend": "node --test tests/resend.live.test.mjs"
  },
  "dependencies": {
    "@sanity/vision": "^3.77.2",
    "next": "14.2.35",
    "next-sanity": "^9.8.61",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.2",
    "sanity": "^3.77.2",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
