# Copy to .env.local and fill in values. Never commit real secrets.

# --- Sanity CMS (required for content + Studio) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=

# Preview / on-demand revalidation
SANITY_PREVIEW_SECRET=
SANITY_WEBHOOK_SECRET=

# Public site URL used by Studio preview / revalidate actions
# Docker (local): http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional HTTP basic auth for /studio in non-production
STUDIO_BASIC_AUTH_USER=
STUDIO_BASIC_AUTH_PASS=

# --- Contact form (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=GTek Website <onboarding@resend.dev>
CONTACT_ACK_FROM_EMAIL=
CONTACT_SEND_ACK=false

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
