# Collection of environment variables used by this project
# Copy values into `.env.local` for local dev or paste into Vercel Project → Settings → Environment Variables.
# IMPORTANT: Do NOT commit secrets. If any secret was accidentally committed to git, rotate it immediately.

# -------------------------
# Public (client-side) vars
# These are bundled into the client — must begin with NEXT_PUBLIC_
# -------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=4jrpajc8
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: API version used by sanity client. Default in code is "2024-01-01".
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# -------------------------
# Server-only (do NOT prefix with NEXT_PUBLIC_)
# These must remain secret and set as server-only in Vercel (or via Vercel Secrets/Env).
# -------------------------
# Sanity server token with read access (this value was present in your .env.local)
SANITY_API_READ_TOKEN=sk9wo4eS32tcKuVDQcPFAf5KrCHWi3o6Na8h8p4U5UbRSNQdQW84cpkBAAUAfU9woc68v6NHmWr25QXa5iPicNrUE2bKADAFxFxiz6jbxzubnC2iL0Led6O1xuF2CPCGv7X9S4NW4yr8MCQLmRzKDDhdG753hAjTrLBfu8cklfaxYRvA9t8y

# Resend email service key (placeholder)
RESEND_API_KEY=
# Where contact form sends messages (defaults to contact@gtekengineering.ca if unset)
CONTACT_TO_EMAIL=contact@gtekengineering.ca
# From address for outgoing contact emails (optional)
CONTACT_FROM_EMAIL="GTek Website <onboarding@resend.dev>"
# From address for acknowledgement emails (optional)
CONTACT_ACK_FROM_EMAIL=
# Enable sending acknowledgement to sender: set to "true" to enable
CONTACT_SEND_ACK=false

# Studio basic auth (optional — used by `src/middleware.ts` to protect /studio route)
# If set, the middleware enforces HTTP Basic Auth for /studio.
STUDIO_BASIC_AUTH_USER=
STUDIO_BASIC_AUTH_PASS=

# -------------------------
# Notes & usage
# - Copy this file to `.env.local` (do not commit `.env.local`).
# - For Vercel: add the same variables under Project → Settings → Environment Variables.
#   * Mark server-only variables as "Environment Variable" (Vercel keeps them secret).
#   * Add values for both "Preview" and "Production" if you want the Studio and API routes to work in preview deploys.
# - The code expects these names exactly (see src/sanity/env.ts and src/app/api/contact/route.ts).
# - If you shared this repo or accidentally pushed secrets, rotate tokens immediately.
# -------------------------
